# ---------------------------------------------------------------------------
# V-Channel Medusa backend - environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# Core
NODE_ENV=development
MEDUSA_BACKEND_URL=http://localhost:9000

# Database (Postgres) and Redis are REQUIRED for production-grade modules
DATABASE_URL=******localhost:5432/v_channel
REDIS_URL=redis://localhost:6379

# Secrets - generate with: openssl rand -base64 32
JWT_SECRET=change-me-in-production
COOKIE_SECRET=change-me-in-production

# CORS - the V-Channel Next.js app on Vercel + admin dashboard origins
STORE_CORS=http://localhost:3000,https://v-channel.vercel.app
ADMIN_CORS=http://localhost:9000,https://admin.v-channel.com
AUTH_CORS=http://localhost:3000,http://localhost:9000,https://v-channel.vercel.app

# Stripe (payments + PPV + subscription billing bridge)
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Stripe Billing price IDs that map to V-Channel membership tiers
STRIPE_PRICE_SUBSCRIBER=price_xxx
STRIPE_PRICE_CREATOR=price_xxx

# SendGrid (newsletters + transactional email)
SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM=hello@v-channel.com

# AWS S3 (media / file storage behind CDN)
S3_FILE_URL=https://cdn.v-channel.com
S3_BUCKET=v-channel-media
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_ACCESS_KEY_ID=xxx
S3_SECRET_ACCESS_KEY=xxx

# PostHog (analytics / audience + revenue insights)
POSTHOG_API_KEY=phc_xxx
POSTHOG_HOST=https://us.i.posthog.com

# Google OAuth (fan + creator social login)
GOOGLE_CLIENT_ID=xxx
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_CALLBACK_URL=http://localhost:9000/auth/customer/google/callback

# GitHub OAuth (optional, for technically-minded creators)
GITHUB_CLIENT_ID=xxx
GITHUB_CLIENT_SECRET=xxx
GITHUB_CALLBACK_URL=http://localhost:9000/auth/customer/github/callback
